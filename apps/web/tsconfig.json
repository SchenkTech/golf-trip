{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    /* Named explicitly, as apps/api does: TypeScript 7 no longer pulls in
       every @types package it can find, so the Node built-ins that
       src/lib/*.test.ts imports have to be asked for. vite/client and
       vite-plugin-pwa/client come from the /// references in
       src/vite-env.d.ts. */
    "types": ["node"]
  },
  "include": ["src"]
}
